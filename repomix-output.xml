  .heat-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);}
  table.mtx{border-collapse:collapse;width:100%;min-width:920px;}
  table.mtx th,table.mtx td{padding:0;text-align:center;}
  table.mtx thead th{position:sticky;top:0;background:var(--surface);border-bottom:1px solid var(--line);padding:11px 7px;font-family:var(--display);font-size:11.5px;font-weight:600;z-index:3;}
  table.mtx thead th.subhead{text-align:left;padding-left:16px;width:360px;}
  table.mtx thead th.actcol{width:46px;}
  tr.pillar-band td{background:var(--ink);color:#fff;text-align:left;padding:9px 16px;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;}
