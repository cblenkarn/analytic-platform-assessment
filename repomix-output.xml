  .moscow button:last-child{border-right:none;}
  .moscow button[data-on="must"].active{background:var(--must);color:#fff;}
  .moscow button[data-on="should"].active{background:var(--should);color:#fff;}
  .moscow button[data-on="could"].active{background:var(--could);color:#fff;}
  .moscow button[data-on="wont"].active{background:var(--wont);color:#fff;}
  .sub-table{margin-top:13px;border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;}
  .sub-caption{background:#F7F9F8;border-bottom:1px solid var(--line-soft);padding:7px 14px;font-family:var(--mono);font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;}
