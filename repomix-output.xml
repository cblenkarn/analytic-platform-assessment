      html += `<label class="ucp-opt ${checked?'checked':''}"><input type="checkbox" data-libeditpick data-lib="${libId}" data-cap="${c.id}" ${checked?'checked':''}><span class="ucp-code">${c.id}</span><span>${esc(c.title)}</span></label>`;
