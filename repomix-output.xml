/* assessment-results.css — results sub-headers + coverage-by-use-case
   Verbatim slice of the original app.css (refactor only partitions it by page/section; rules unchanged). */
  /* ===== assessment results sub-headers ===== */
  .sec-h{font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:-.01em;margin:30px 0 14px;padding-bottom:9px;border-bottom:1px solid var(--line);}
  .results-actions{display:flex;justify-content:flex-end;margin:4px 0 4px;}


  /* ================================================================ */
  /* ===== RESULTS TAB — Coverage by use case ======================= */
  /* ================================================================ */
  .uc-coverage-wrap{display:block;margin-bottom:6px;}
  .uc-coverage-wrap[hidden]{display:none;}
  .uc-verdict{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--r);padding:18px 22px;margin-bottom:18px;box-shadow:var(--shadow);}
  .uc-verdict .uv-eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--accent-deep);margin-bottom:4px;}
  .uc-verdict .uv-title{font-family:var(--display);font-size:22px;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin-bottom:8px;line-height:1.15;}
  .uc-verdict .uv-body{font-size:13.5px;line-height:1.55;color:var(--ink-soft);}
  .uc-verdict .uv-body b{color:var(--ink);font-weight:600;}
  .uc-verdict .uv-detail{font-size:12.8px;line-height:1.55;color:var(--ink-soft);margin-top:8px;}
  .uc-verdict .uv-detail b{color:var(--ink);font-weight:600;}
  .uc-verdict .uv-runner{margin-top:12px;padding-top:11px;border-top:1px solid var(--line-soft);font-size:12.5px;color:var(--ink-soft);line-height:1.5;}
  .uc-verdict .uv-runner b{color:var(--ink);font-weight:600;}

  /* Small pillar/cap breadcrumb under each use case row title */
  .uc-caps-sub{font-family:var(--mono);font-size:10px;letter-spacing:.03em;color:var(--ink-soft);margin-top:3px;text-transform:none;font-weight:500;}
</file>

<file path="css/base.css">
/* base.css — tokens, reset, brand bar, tabs, readme, result blocks
   Verbatim slice of the original app.css (refactor only partitions it by page/section; rules unchanged). */
:root{
    --paper:#F4F5F7; --surface:#FFFFFF; --ink:#0B0B0C; --ink-soft:#586273;
    --line:#E2E5EA; --line-soft:#EEF0F3;
    --accent:#1B3BE0; --accent-deep:#102597; --leader:#1B3BE0;
    --yes:#1B3BE0; --yes-bg:#E9ECFD; --no:#B7C0C2; --gap:#C7283A; --gap-bg:#FBECEE;
    --must:#C7283A; --should:#B5731A; --could:#0E8F7E; --wont:#8A9098;
    --must-bg:#FBECEE; --should-bg:#FBF2E5; --could-bg:#E4F3F0; --wont-bg:#F0F2F3;
    --display:'Inter',sans-serif; --body:'Inter',sans-serif; --mono:'IBM Plex Mono',monospace;
    --r:10px; --shadow:0 1px 2px rgba(11,11,12,.05),0 4px 16px rgba(11,11,12,.05);
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5;}
  .wrap{max-width:1260px;margin:0 auto;padding:0 24px 80px;}
  h1,h2,h3{font-family:var(--display);margin:0;font-weight:600;letter-spacing:-.01em;}
  .mono{font-family:var(--mono);} button{font-family:var(--body);cursor:pointer;}
  ::selection{background:#1B3BE033;}

  /* ===== Merkle brand banner ===== */
  header.brandbar{background:#0B0B0C;padding:0;margin:0;}
  .brandbar-inner{max-width:1260px;margin:0 auto;padding:19px 24px;display:flex;align-items:center;gap:15px;}
  .mk-logo{display:inline-flex;align-items:center;line-height:1;text-decoration:none;color:inherit;}
  .mk-logo-img{height:26px;width:210px;display:inline-block;background:url(data:image/png;base64,) left center/contain no-repeat;}
  .foot-brand .mk-logo-img{height:24px;width:190px;}
  .mk-print-word{display:none;font-family:var(--display);font-weight:800;font-size:22px;letter-spacing:-.02em;}
  .mk-logo .mk-dot{color:var(--accent);} 
  .mk-sep{width:1px;height:22px;background:#3a3a40;}
  .mk-title{font-family:var(--display);font-weight:600;font-size:14.5px;color:#c7cbd1;letter-spacing:.01em;}
  @media(max-width:560px){.mk-sep,.mk-title{display:none;}}
  /* ===== About (collapsible) ===== */
  .about{margin:22px 0 0;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);}
  .about summary{list-style:none;cursor:pointer;padding:13px 18px;font-weight:600;font-size:14px;display:flex;align-items:center;gap:10px;color:var(--ink);font-family:var(--display);}
  .about summary::-webkit-details-marker{display:none;}
  .about summary .about-caret{margin-left:auto;color:var(--ink-soft);font-family:var(--mono);font-size:12px;transition:.2s;}
  .about[open] summary .about-caret{transform:rotate(180deg);}
  .about-body{padding:0 18px 16px;color:var(--ink-soft);font-size:14px;line-height:1.62;max-width:880px;}
  /* ===== Tabs ===== */
  .tabs{display:flex;gap:2px;border-bottom:2px solid var(--line);margin:24px 0 26px;flex-wrap:wrap;}
  .tab{border:none;background:none;padding:12px 20px;font-size:14px;font-weight:600;color:var(--ink-soft);border-bottom:2px solid transparent;margin-bottom:-2px;font-family:var(--display);transition:.12s;}
  .tab:hover{color:var(--ink);} .tab.active{color:var(--accent);border-bottom-color:var(--accent);}
  .panel{display:none;} .panel.active{display:block;animation:fade .22s ease;}
  @keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  /* ===== Read-me callouts ===== */
  .readme{background:#EEF1FE;border:1px solid #D5DCFB;border-left:3px solid var(--accent);border-radius:9px;padding:13px 16px;margin-bottom:24px;font-size:13.5px;line-height:1.55;color:#243072;}
  .readme b{color:var(--accent-deep);} .readme .rm-title{display:block;font-weight:700;margin-bottom:3px;color:var(--accent-deep);font-family:var(--display);}
  /* ===== Result blocks + actions ===== */
  .block{margin-bottom:36px;}
  .block-head{display:flex;align-items:baseline;gap:12px;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;flex-wrap:wrap;}
  .block-head h2{font-size:19px;font-family:var(--display);font-weight:700;letter-spacing:-.01em;}
  .block-head .hint{font-size:12.5px;color:var(--ink-soft);margin-left:auto;text-align:right;}
  .panel-actions{display:flex;gap:8px;align-items:center;margin-bottom:18px;flex-wrap:wrap;}
  .panel-actions .spacer{flex:1;}
</file>

<file path="css/chrome.css">
/* chrome.css — methodology footer, assessment bar, sub-nav / autosave / sync
   Verbatim slice of the original app.css (refactor only partitions it by page/section; rules unchanged). */
  /* ===== Methodology footer ===== */
  .site-foot{background:#0B0B0C;color:#c7cbd1;margin-top:48px;}
  .foot-inner{max-width:1260px;margin:0 auto;padding:36px 24px 44px;display:grid;grid-template-columns:200px 1fr;gap:34px;}
  .foot-brand .mk-logo{font-family:var(--display);font-weight:800;font-size:22px;color:#fff;letter-spacing:-.02em;}
  .foot-brand .mk-dot{color:var(--accent);}
  .foot-tag{font-size:12.5px;color:#8a9097;margin-top:7px;}
  .foot-method h3{font-family:var(--display);font-size:15px;color:#fff;font-weight:700;margin-bottom:11px;}
  .foot-method p{font-size:13px;line-height:1.62;color:#b3b8bf;margin:0 0 11px;max-width:780px;}
  .foot-method .foot-fine{font-size:11.5px;color:#7e848b;}
  @media(max-width:680px){.foot-inner{grid-template-columns:1fr;gap:18px;}}
  @media print{
    body{background:#fff;} .tabs,.readme,.panel-actions,.brandbar .mk-title,.pillar-head .caret{display:none;}
    .panel{display:none!important;} .panel.active{display:block!important;}
    .btn,.stack-card{box-shadow:none;} .block,.pcard,.rank{break-inside:avoid;}
    .site-foot{background:#fff!important;color:var(--ink-soft)!important;border-top:1px solid var(--line);margin-top:24px;}
    .site-foot .mk-logo,.foot-method h3{color:var(--ink)!important;} .foot-method p{color:var(--ink-soft)!important;}
    .mk-logo-img{display:none!important;} .mk-print-word{display:inline!important;color:var(--ink)!important;}
  }
  /* ===== cloud / assessment bar ===== */
  .assess-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 24px;padding:11px 14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);}
  .assess-bar .ab-label{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--ink-soft);}
  .assess-bar select,.assess-bar .ab-input{border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-family:var(--body);font-size:13px;background:#fff;color:var(--ink);}
  .assess-bar .ab-input{min-width:170px;}
  .cloud-status{font-size:12px;color:var(--ink-soft);font-family:var(--mono);}
  .cloud-status.ok{color:var(--accent-deep);} .cloud-status.err{color:var(--gap);}

  /* ===== sub-nav / autosave / sync ===== */
  .subnav{max-width:1260px;margin:0 auto;padding:16px 24px 0;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
  .backlink{font-size:13px;font-weight:600;color:var(--accent);text-decoration:none;}
  .backlink:hover{text-decoration:underline;}
  .subnav .sn-title{font-family:var(--display);font-weight:700;font-size:15px;}
  .autosave{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--ink-soft);display:inline-flex;align-items:center;gap:7px;}
  .autosave .dot{width:8px;height:8px;border-radius:50%;background:var(--wont);transition:.2s;}
  .autosave.saving .dot{background:var(--should);} .autosave.saved .dot{background:var(--accent);} .autosave.err .dot{background:var(--gap);}
  .sync-banner{max-width:1260px;margin:14px auto 0;padding:11px 16px;background:var(--should-bg);border:1px solid #ECD9B0;border-radius:9px;color:#7A5A12;font-size:13px;display:none;align-items:center;gap:12px;}
  .sync-banner.show{display:flex;}
</file>

<file path="css/components.css">
/* components.css — shared components: scoreboard, framework, matrix, profiles, popover
   Verbatim slice of the original app.css (refactor only partitions it by page/section; rules unchanged). */
  /* ===== Discovery refine ===== */
  .moscow.big button{padding:9px 15px;font-size:11.5px;}
  .refine-toggle{margin-top:13px;border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 13px;font-size:12.5px;font-weight:600;color:var(--ink-soft);display:inline-flex;align-items:center;gap:8px;}
  .refine-toggle:hover{border-color:var(--accent);color:var(--accent-deep);}
  .refine-toggle .rc{font-family:var(--mono);font-size:11px;transition:.2s;}
  .cap .sub-table{display:none;} .cap.open .sub-table{display:block;} .cap.open .refine-toggle .rc{transform:rotate(180deg);}
  .cap.oos-cap{opacity:.55;}
  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent-deep);font-weight:600;}
  header h1{font-size:34px;line-height:1.08;margin:10px 0 8px;max-width:790px;}
  header p{color:var(--ink-soft);max-width:710px;margin:0;font-size:15px;}
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;align-items:center;}
  .btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:8px 14px;border-radius:8px;font-size:13px;font-weight:500;display:inline-flex;align-items:center;gap:7px;transition:.12s;}
  .btn:hover{border-color:var(--accent);color:var(--accent-deep);}
  .btn-primary{background:var(--ink);color:#fff;border-color:var(--ink);}
  .btn-primary:hover{background:var(--accent-deep);border-color:var(--accent-deep);color:#fff;}
  .toolbar .spacer{flex:1;}
  .lock-note{font-family:var(--mono);font-size:11px;color:var(--ink-soft);display:inline-flex;align-items:center;gap:6px;}
  .lock-note .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);}

  section{margin-top:34px;}
  .sec-head{display:flex;align-items:baseline;gap:12px;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;}
  .sec-head .num{font-family:var(--mono);font-size:12px;color:var(--accent);font-weight:600;}
  .sec-toggle{cursor:pointer;user-select:none;}
  .seccaret{font-family:var(--mono);color:var(--ink-soft);margin-left:14px;transition:transform .2s;align-self:center;}
  .collapsible.collapsed .seccaret{transform:rotate(-90deg);}
  .collapsible.collapsed .sec-body{display:none;}
  .sec-head h2{font-size:19px;}
