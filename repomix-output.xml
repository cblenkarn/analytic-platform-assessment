  tr.cap-band td{background:#F2F5F4;text-align:left;padding:7px 16px;font-size:11.5px;font-weight:600;color:var(--ink);}
  tr.cap-band td .cc{font-family:var(--mono);color:var(--accent);margin-right:7px;}
  tr.cap-band td .chip{font-family:var(--mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:1px 6px;border-radius:4px;margin-left:8px;}
  .chip.must{color:var(--must);background:var(--must-bg);} .chip.should{color:var(--should);background:var(--should-bg);}
  .chip.could{color:var(--could);background:var(--could-bg);} .chip.wont{color:var(--wont);background:var(--wont-bg);}
  .ed-btn{margin-left:10px;border:1px dashed var(--accent);background:#fff;color:var(--accent-deep);font-family:var(--mono);font-size:9.5px;font-weight:600;padding:2px 8px;border-radius:5px;}
  .ed-btn:hover{background:var(--yes-bg);}
