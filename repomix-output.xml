  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5;}
  .wrap{max-width:1260px;margin:0 auto;padding:0 24px 80px;}
  h1,h2,h3{font-family:var(--display);margin:0;font-weight:600;letter-spacing:-.01em;}
  .mono{font-family:var(--mono);} button{font-family:var(--body);cursor:pointer;}
  ::selection{background:#1B3BE033;}

  /* ===== Merkle brand banner ===== */
  header.brandbar{background:#0B0B0C;padding:0;margin:0;}
  .brandbar-inner{max-width:1260px;margin:0 auto;padding:19px 24px;display:flex;align-items:center;gap:15px;}
  .mk-logo{display:inline-flex;align-items:center;line-height:1;text-decoration:none;color:inherit;}
  .mk-logo-img{height:26px;width:210px;display:inline-block;background:url(data:image/png;base64,) left center/contain no-repeat;}
  .foot-brand .mk-logo-img{height:24px;width:190px;}
  .mk-print-word{display:none;font-family:var(--display);font-weight:800;font-size:22px;letter-spacing:-.02em;}
  .mk-logo .mk-dot{color:var(--accent);} 
  .mk-sep{width:1px;height:22px;background:#3a3a40;}
  .mk-title{font-family:var(--display);font-weight:600;font-size:14.5px;color:#c7cbd1;letter-spacing:.01em;}
  @media(max-width:560px){.mk-sep,.mk-title{display:none;}}
  /* ===== About (collapsible) ===== */
  .about{margin:22px 0 0;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);}
  .about summary{list-style:none;cursor:pointer;padding:13px 18px;font-weight:600;font-size:14px;display:flex;align-items:center;gap:10px;color:var(--ink);font-family:var(--display);}
  .about summary::-webkit-details-marker{display:none;}
  .about summary .about-caret{margin-left:auto;color:var(--ink-soft);font-family:var(--mono);font-size:12px;transition:.2s;}
  .about[open] summary .about-caret{transform:rotate(180deg);}
  .about-body{padding:0 18px 16px;color:var(--ink-soft);font-size:14px;line-height:1.62;max-width:880px;}
  /* ===== Tabs ===== */
  .tabs{display:flex;gap:2px;border-bottom:2px solid var(--line);margin:24px 0 26px;flex-wrap:wrap;}
  .tab{border:none;background:none;padding:12px 20px;font-size:14px;font-weight:600;color:var(--ink-soft);border-bottom:2px solid transparent;margin-bottom:-2px;font-family:var(--display);transition:.12s;}
  .tab:hover{color:var(--ink);} .tab.active{color:var(--accent);border-bottom-color:var(--accent);}
  .panel{display:none;} .panel.active{display:block;animation:fade .22s ease;}
  @keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  /* ===== Read-me callouts ===== */
  .readme{background:#EEF1FE;border:1px solid #D5DCFB;border-left:3px solid var(--accent);border-radius:9px;padding:13px 16px;margin-bottom:24px;font-size:13.5px;line-height:1.55;color:#243072;}
  .readme b{color:var(--accent-deep);} .readme .rm-title{display:block;font-weight:700;margin-bottom:3px;color:var(--accent-deep);font-family:var(--display);}
  /* ===== Result blocks + actions ===== */
  .block{margin-bottom:36px;}
  .block-head{display:flex;align-items:baseline;gap:12px;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;flex-wrap:wrap;}
  .block-head h2{font-size:19px;font-family:var(--display);font-weight:700;letter-spacing:-.01em;}
  .block-head .hint{font-size:12.5px;color:var(--ink-soft);margin-left:auto;text-align:right;}
  .panel-actions{display:flex;gap:8px;align-items:center;margin-bottom:18px;flex-wrap:wrap;}
  .panel-actions .spacer{flex:1;}
  /* ===== Discovery refine ===== */
  .moscow.big button{padding:9px 15px;font-size:11.5px;}
  .refine-toggle{margin-top:13px;border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 13px;font-size:12.5px;font-weight:600;color:var(--ink-soft);display:inline-flex;align-items:center;gap:8px;}
  .refine-toggle:hover{border-color:var(--accent);color:var(--accent-deep);}
  .refine-toggle .rc{font-family:var(--mono);font-size:11px;transition:.2s;}
  .cap .sub-table{display:none;} .cap.open .sub-table{display:block;} .cap.open .refine-toggle .rc{transform:rotate(180deg);}
  .cap.oos-cap{opacity:.55;}
  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent-deep);font-weight:600;}
  header h1{font-size:34px;line-height:1.08;margin:10px 0 8px;max-width:790px;}
  header p{color:var(--ink-soft);max-width:710px;margin:0;font-size:15px;}
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;align-items:center;}
  .btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:8px 14px;border-radius:8px;font-size:13px;font-weight:500;display:inline-flex;align-items:center;gap:7px;transition:.12s;}
  .btn:hover{border-color:var(--accent);color:var(--accent-deep);}
  .btn-primary{background:var(--ink);color:#fff;border-color:var(--ink);}
  .btn-primary:hover{background:var(--accent-deep);border-color:var(--accent-deep);color:#fff;}
  .toolbar .spacer{flex:1;}
  .lock-note{font-family:var(--mono);font-size:11px;color:var(--ink-soft);display:inline-flex;align-items:center;gap:6px;}
  .lock-note .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);}

  section{margin-top:34px;}
  .sec-head{display:flex;align-items:baseline;gap:12px;margin-bottom:14px;border-bottom:1px solid var(--line);padding-bottom:10px;}
  .sec-head .num{font-family:var(--mono);font-size:12px;color:var(--accent);font-weight:600;}
  .sec-toggle{cursor:pointer;user-select:none;}
  .seccaret{font-family:var(--mono);color:var(--ink-soft);margin-left:14px;transition:transform .2s;align-self:center;}
  .collapsible.collapsed .seccaret{transform:rotate(-90deg);}
  .collapsible.collapsed .sec-body{display:none;}
  .sec-head h2{font-size:19px;}
  .sec-head .hint{font-size:12.5px;color:var(--ink-soft);margin-left:auto;text-align:right;}

  .scoreboard{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;}
  .rank-list{display:flex;flex-direction:column;gap:9px;}
  .rank{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:13px 16px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  .rank.top{border-color:var(--accent);}
  .rank .pos{font-family:var(--mono);font-size:13px;color:var(--ink-soft);font-weight:600;}
  .rank.top .pos{color:var(--accent);}
  .rank .pname{font-weight:600;font-size:15px;}
  .rank .psub{font-size:11.5px;color:var(--ink-soft);font-family:var(--mono);margin-top:1px;}
  .rank .pct{font-family:var(--display);font-size:24px;font-weight:600;text-align:right;line-height:1;}
  .rank .pct span{font-size:12px;color:var(--ink-soft);font-weight:500;}
  .bar-track{grid-column:1/-1;height:5px;background:var(--line-soft);border-radius:3px;margin-top:11px;overflow:hidden;}
  .bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-deep));border-radius:3px;transition:width .35s ease;}

  .stack-card{background:var(--ink);color:#fff;border-radius:var(--r);padding:22px;box-shadow:var(--shadow);align-self:start;}
  .stack-card h3{color:#fff;font-size:15px;margin-bottom:4px;}
  .stack-card .lead-sub{font-size:12px;color:#9fb0b3;font-family:var(--mono);margin-bottom:16px;}
  .stack-row{padding:12px 0;border-top:1px solid #2a3744;} .stack-row:first-of-type{border-top:none;}
  .stack-role{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--leader);font-weight:600;}
  .stack-name{font-family:var(--display);font-size:17px;font-weight:600;margin:3px 0 4px;}
  .stack-reason{font-size:12.5px;color:#b9c4c8;line-height:1.45;} .stack-empty{font-size:13px;color:#9fb0b3;line-height:1.5;}

  .pill-grid{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);}
  table.agg{border-collapse:collapse;width:100%;min-width:760px;}
  table.agg th,table.agg td{padding:12px 10px;border-bottom:1px solid var(--line-soft);text-align:center;}
  table.agg thead th{font-family:var(--display);font-size:12px;font-weight:600;background:var(--surface);border-bottom:1px solid var(--line);}
  table.agg thead th.lbl,table.agg td.lbl{text-align:left;width:220px;}
  table.agg td.lbl .pl-letter{font-family:var(--mono);font-size:11px;font-weight:600;color:#fff;background:var(--accent-deep);width:22px;height:22px;border-radius:5px;display:inline-grid;place-items:center;margin-right:9px;vertical-align:middle;}
  table.agg td.lbl b{font-weight:600;font-size:13px;}
  table.agg tr.total td{border-top:1px solid var(--line);border-bottom:none;background:#FAFBFA;}
  table.agg tr.total td.lbl{font-family:var(--display);font-weight:600;}
  .cell-cov{display:flex;flex-direction:column;align-items:center;gap:5px;}
  .cell-cov .n{font-family:var(--mono);font-size:12px;font-weight:600;}
  .cell-cov .mini{width:48px;height:5px;background:var(--line-soft);border-radius:3px;overflow:hidden;}
  .cell-cov .mini i{display:block;height:100%;background:var(--accent);border-radius:3px;}
  td.cov.leader{background:#EEF1FE;box-shadow:inset 0 0 0 2px var(--leader);} td.cov.leader .n{color:var(--leader);}
  .cell-na{color:var(--no);font-family:var(--mono);font-size:11px;}

  .pillar{margin-bottom:14px;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);overflow:hidden;}
  .pillar-head{display:flex;align-items:center;gap:12px;padding:15px 18px;cursor:pointer;user-select:none;background:linear-gradient(180deg,#fff,#fbfcfb);}
  .pillar-head .pl-letter{font-family:var(--mono);font-size:12px;font-weight:600;color:#fff;background:var(--accent-deep);width:26px;height:26px;border-radius:6px;display:grid;place-items:center;}
  .pillar-head h3{font-size:15.5px;}
  .pillar-head .pl-count{font-family:var(--mono);font-size:11px;color:var(--ink-soft);margin-left:8px;}
  .pillar-head .caret{margin-left:auto;color:var(--ink-soft);transition:transform .2s;font-family:var(--mono);}
  .pillar.collapsed .caret{transform:rotate(-90deg);} .pillar.collapsed .pillar-body{display:none;}
  .pillar-body{padding:4px 0 8px;}
  .cap{padding:16px 18px;border-top:1px solid var(--line-soft);}
  .cap-top{display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;}
  .cap-id{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--accent);padding-top:3px;}
  .cap-title-wrap{flex:1;min-width:240px;}
  .cap-title{font-weight:600;font-size:14.5px;display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
  .cap-title .selcount{font-family:var(--mono);font-size:10.5px;font-weight:500;color:var(--ink-soft);background:var(--line-soft);padding:1px 7px;border-radius:20px;}
  .cap-title .selcount.has{color:var(--accent-deep);background:#E4F1F1;}
  .cap-def{font-size:12.5px;color:var(--ink-soft);margin-top:3px;line-height:1.45;}
  .cap-empty{font-size:12px;color:var(--ink-soft);font-style:italic;margin-top:10px;}
  .moscow{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;align-self:flex-start;}
  .moscow button{border:none;background:var(--surface);padding:6px 11px;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--ink-soft);border-right:1px solid var(--line);transition:.12s;}
  .moscow button:last-child{border-right:none;}
  .moscow button[data-on="must"].active{background:var(--must);color:#fff;}
  .moscow button[data-on="should"].active{background:var(--should);color:#fff;}
  .moscow button[data-on="could"].active{background:var(--could);color:#fff;}
  .moscow button[data-on="wont"].active{background:var(--wont);color:#fff;}
  .sub-table{margin-top:13px;border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;}
  .sub-caption{background:#F7F9F8;border-bottom:1px solid var(--line-soft);padding:7px 14px;font-family:var(--mono);font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;}
  .sub-row{display:flex;align-items:center;gap:12px;padding:9px 14px;border-top:1px solid var(--line-soft);}
  .sub-row:first-of-type{border-top:none;} .sub-row.disabled{opacity:.4;pointer-events:none;}
  .sub-q{flex:1;font-size:12.8px;display:flex;gap:10px;align-items:flex-start;line-height:1.38;cursor:pointer;}
  .sub-q input[type=checkbox]{margin-top:1px;width:16px;height:16px;accent-color:var(--accent);flex:none;cursor:pointer;}
  .sub-sup{flex:none;font-family:var(--mono);font-size:10px;color:var(--ink-soft);}

  .matrix-toolbar{display:flex;align-items:center;gap:18px;margin-bottom:12px;flex-wrap:wrap;}
  .toggle{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);cursor:pointer;user-select:none;}
  .toggle input{width:16px;height:16px;accent-color:var(--accent);}
  .toggle.edit{font-weight:600;color:var(--ink);}
  .btn-add-pillar{display:none;border:1px dashed var(--accent);background:#fff;color:var(--accent-deep);font-family:var(--mono);font-size:11px;font-weight:600;padding:5px 12px;border-radius:7px;}
  .btn-add-pillar.on{display:inline-flex;} .btn-add-pillar:hover{background:var(--yes-bg);}
  table.mtx thead th.plhead{padding:8px 6px;}
  th.plhead.dragging{opacity:.4;} th.plhead.drop-target{box-shadow:inset 3px 0 0 var(--accent);}
  .plh{display:flex;flex-direction:column;align-items:center;gap:4px;}
  .plh [contenteditable]{min-width:28px;outline:none;border-radius:4px;padding:0 3px;}
  .plh [contenteditable]:focus{box-shadow:inset 0 0 0 2px var(--accent);background:#F7FBFF;}
  .drag-handle{cursor:grab;color:#AEB7B6;font-size:13px;line-height:1;user-select:none;}
  .drag-handle:hover{color:var(--accent-deep);} .drag-handle:active{cursor:grabbing;}
  .plretire{border:none;background:none;color:#9aa4a3;font-family:var(--mono);font-size:9px;letter-spacing:.04em;text-transform:uppercase;font-weight:600;cursor:pointer;padding:2px 5px;border-radius:4px;}
  .plretire:hover{color:var(--should);background:var(--should-bg);}
  .retired-bar{margin-top:14px;display:none;flex-wrap:wrap;gap:8px;align-items:center;}
  .rb-label{font-family:var(--mono);font-size:10px;letter-spacing:.07em;text-transform:uppercase;font-weight:600;color:var(--wont);}
  .retired-chip{display:inline-flex;align-items:center;gap:8px;border:1px dashed var(--line);border-radius:20px;padding:4px 6px 4px 12px;background:var(--surface);font-size:12.5px;}
  .retired-chip b{font-weight:600;color:var(--ink-soft);}
  .retired-chip button{border:none;background:none;color:var(--accent);font-weight:600;font-size:12px;cursor:pointer;padding:2px 8px;border-radius:14px;}
  .retired-chip button:hover{background:var(--yes-bg);}
  .edit-banner{margin-bottom:12px;background:var(--should-bg);border:1px solid #ECD9B0;border-radius:8px;padding:9px 14px;font-size:12.5px;color:#7A5A12;display:none;}
  .edit-banner.on{display:block;}
  .matrix-key{display:flex;gap:16px;font-size:12px;color:var(--ink-soft);flex-wrap:wrap;margin-left:auto;align-items:center;}
  .matrix-key .k{display:inline-flex;align-items:center;gap:6px;}
  .heat-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);}
  table.mtx{border-collapse:collapse;width:100%;min-width:920px;}
  table.mtx th,table.mtx td{padding:0;text-align:center;}
  table.mtx thead th{position:sticky;top:0;background:var(--surface);border-bottom:1px solid var(--line);padding:11px 7px;font-family:var(--display);font-size:11.5px;font-weight:600;z-index:3;}
  table.mtx thead th.subhead{text-align:left;padding-left:16px;width:360px;}
  table.mtx thead th.actcol{width:46px;}
  tr.pillar-band td{background:var(--ink);color:#fff;text-align:left;padding:9px 16px;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;}
  tr.pillar-band .pname[contenteditable="true"]{text-transform:none;letter-spacing:0;}
  tr.cap-band td{background:#F2F5F4;text-align:left;padding:7px 16px;font-size:11.5px;font-weight:600;color:var(--ink);}
  tr.cap-band td .cc{font-family:var(--mono);color:var(--accent);margin-right:7px;}
  tr.cap-band td .chip{font-family:var(--mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:1px 6px;border-radius:4px;margin-left:8px;}
  .chip.must{color:var(--must);background:var(--must-bg);} .chip.should{color:var(--should);background:var(--should-bg);}
  .chip.could{color:var(--could);background:var(--could-bg);} .chip.wont{color:var(--wont);background:var(--wont-bg);}
  .ed-btn{margin-left:10px;border:1px dashed var(--accent);background:#fff;color:var(--accent-deep);font-family:var(--mono);font-size:9.5px;font-weight:600;padding:2px 8px;border-radius:5px;}
  .ed-btn:hover{background:var(--yes-bg);}
  .ed-btn.danger{border-color:#E2B6BC;color:var(--gap);} .ed-btn.danger:hover{background:var(--gap-bg);}
  tr.pillar-band .ed-btn{border-color:#5a6b78;color:#cfe3e6;background:transparent;} tr.pillar-band .ed-btn:hover{background:#243341;}
  [contenteditable="true"]{outline:none;cursor:text;border-radius:5px;padding:1px 5px;margin:-1px -2px;}
  [contenteditable="true"]:focus{box-shadow:inset 0 0 0 2px var(--accent);background:#F7FBFB;color:var(--ink);}
  tr.pillar-band .pname[contenteditable="true"]:focus{background:#243341;color:#fff;box-shadow:inset 0 0 0 2px var(--accent);}
  table.mtx td.sub-lbl{text-align:left;padding:8px 10px 8px 30px;font-size:12px;line-height:1.35;border-bottom:1px solid var(--line-soft);color:var(--ink-soft);}
  table.mtx tr.needed td.sub-lbl{color:var(--ink);font-weight:500;}
  table.mtx tr.needed{background:#F2FAF9;} table.mtx tr.flat td.sub-lbl{color:#9aa4a3;}
  .qtext[contenteditable="true"]{display:inline-block;min-width:120px;}
  .cflag{display:inline-block;font-family:var(--mono);font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;color:var(--wont);background:var(--wont-bg);padding:1px 5px;border-radius:4px;margin-left:8px;vertical-align:middle;}
  td.mk{border-bottom:1px solid var(--line-soft);border-left:1px solid var(--line-soft);height:38px;}
  td.mk.editable{cursor:pointer;} td.mk.editable:hover{background:#F2FAF9;}
  td.act{border-bottom:1px solid var(--line-soft);width:46px;}
  .row-del{border:none;background:none;color:var(--no);font-size:16px;line-height:1;padding:4px 8px;border-radius:5px;}
  .row-del:hover{color:var(--gap);background:var(--gap-bg);}
  .ck{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;font-size:12px;font-weight:700;margin:0 auto;}
  .ck.on{color:var(--no);} .ck.point{color:#fff;background:var(--yes);} .ck.off{color:#D5DBDA;font-weight:400;}
  .ck.gap{color:var(--no);font-weight:600;} .ck.gap.must{color:var(--gap);background:var(--gap-bg);}
  .ck.tog-on{color:#fff;background:var(--yes);} .ck.tog-off{color:#CBD4D3;font-weight:400;}
  table.mtx tfoot td{position:sticky;bottom:0;background:#FAFBFA;border-top:1px solid var(--line);padding:11px 7px;}
  table.mtx tfoot td.subhead{text-align:left;padding-left:16px;font-family:var(--display);font-weight:600;font-size:12.5px;}
  .foot-pts{font-family:var(--display);font-size:16px;font-weight:600;}
  .foot-pts small{font-family:var(--mono);font-size:10px;color:var(--ink-soft);font-weight:500;display:block;margin-top:2px;}

  .profiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:16px;}
  .pcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--shadow);}
  .pcard h3{font-size:15px;display:flex;align-items:center;justify-content:space-between;}
  .pcard .pcode{font-family:var(--mono);font-size:11px;color:var(--accent);font-weight:600;}
  .pc-block{margin-top:12px;} .pc-label{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;margin-bottom:6px;}
  .pc-label.pro{color:var(--accent-deep);} .pc-label.con{color:var(--must);}
  .pc-text{font-size:12.5px;color:var(--ink-soft);line-height:1.5;margin-bottom:4px;display:flex;gap:7px;}
  .pc-text .b{color:var(--line);flex:none;} .pc-text.con .b{color:#d9b3b8;}
  .pcard h3{justify-content:flex-start;gap:9px;font-weight:700;}
  .pcard .prank{font-family:var(--mono);font-size:11px;color:var(--ink-soft);font-weight:600;}
  .pcard .pfit{margin-left:auto;font-family:var(--display);font-size:18px;font-weight:700;color:var(--accent);}
  .pcard.dq .pfit{color:var(--gap);}
  .pcard .pdq{margin:9px 0 2px;font-family:var(--mono);font-size:10px;color:var(--gap);background:var(--gap-bg);border-radius:5px;padding:4px 8px;line-height:1.4;}
  .pc-cap{display:flex;gap:8px;align-items:flex-start;font-size:12.8px;line-height:1.4;margin-bottom:5px;color:var(--ink);}
  .pc-cap .pc-tick{flex:none;font-weight:700;width:14px;text-align:center;}
  .pc-tick.s{color:var(--yes);} .pc-tick.partial{color:var(--should);} .pc-tick.gap{color:var(--gap);}
  .pc-cap .chip{font-size:8.5px;}
  .pc-cap .pc-sub{color:var(--ink-soft);font-size:11.5px;}
  .pc-note{font-size:12px;color:var(--ink-soft);font-style:italic;margin:-2px 0 9px 22px;line-height:1.45;}
  .pc-more{font-size:11.5px;color:var(--ink-soft);margin:3px 0 0 22px;}
  .pc-empty{font-size:12.3px;color:var(--ink-soft);font-style:italic;}
  .pc-ref{margin-top:13px;border-top:1px solid var(--line-soft);padding-top:10px;}
  .pc-ref summary{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);cursor:pointer;font-weight:600;list-style:none;}
  .pc-ref summary::-webkit-details-marker{display:none;}
  .pc-ref .pc-text{margin-top:8px;}
  .footnote{margin-top:30px;font-size:12px;color:var(--ink-soft);border-top:1px solid var(--line);padding-top:14px;line-height:1.6;}

  .rank.dq{opacity:.9;} .rank.dq .bar-fill{background:linear-gradient(90deg,#cf5b66,#9e2b38);}
  .rank .pct.dqp{color:var(--gap);}
  .dq-badge{grid-column:1/-1;margin-top:9px;font-family:var(--mono);font-size:10.5px;color:var(--gap);background:var(--gap-bg);border-radius:6px;padding:5px 9px;line-height:1.45;}
  td.mk{position:relative;}
  td.mk.hasnote .ck::after{content:"";position:absolute;top:5px;right:7px;width:6px;height:6px;border-radius:50%;background:var(--leader);}
  td.mk.hasnote{cursor:help;}
  .noteglyph{position:absolute;top:2px;right:2px;border:none;background:none;font-size:11px;line-height:1;color:#C2CBCA;padding:2px 3px;border-radius:4px;cursor:pointer;}
  .noteglyph:hover{color:var(--accent-deep);background:var(--yes-bg);} .noteglyph.has{color:var(--leader);}
  td.sub-lbl.oos{opacity:.5;}
  .rat-pop{position:fixed;z-index:60;max-width:300px;background:var(--ink);color:#fff;border-radius:10px;padding:13px 15px;box-shadow:0 10px 34px rgba(22,32,43,.30);font-size:12.5px;line-height:1.5;display:none;}
  .rat-pop.show{display:block;}
  .rat-pop .rp-head{font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:#9fb0b3;margin-bottom:6px;}
  .rat-pop .rp-sub{font-family:var(--display);font-weight:600;margin-bottom:8px;color:#fff;font-size:13px;}
  .rat-pop .rp-tone{display:inline-block;font-family:var(--mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:2px 7px;border-radius:4px;margin-bottom:8px;}
  .rp-tone.pro{background:#13494f;color:#7fe0d6;} .rp-tone.con{background:#5c2a30;color:#f3b0b8;} .rp-tone.note{background:#2a3744;color:#c2cdd1;}
  .rat-pop .rp-note{color:#e7edec;} .rat-pop .rp-empty{color:#8a9698;font-style:italic;}
  .rat-pop textarea{width:100%;min-height:66px;background:#0f1822;border:1px solid #2a3744;color:#fff;border-radius:7px;padding:8px;font-family:var(--body);font-size:12.5px;resize:vertical;margin-top:2px;box-sizing:border-box;}
  .rat-pop .rp-controls{display:flex;gap:8px;margin-top:8px;}
  .rat-pop select{flex:1;background:#0f1822;border:1px solid #2a3744;color:#fff;border-radius:6px;padding:5px;font-family:var(--mono);font-size:11px;}
  .rat-pop .rp-close{margin-top:10px;width:100%;border:1px solid #2a3744;background:#1d2935;color:#fff;border-radius:7px;padding:7px;font-size:12.5px;font-weight:500;}
  .rat-pop .rp-close:hover{background:var(--accent-deep);border-color:var(--accent-deep);}
  @media (max-width:820px){
    .scoreboard{grid-template-columns:1fr;} header h1{font-size:27px;}
    .sec-head{flex-wrap:wrap;} .sec-head .hint{margin-left:0;text-align:left;width:100%;} .matrix-key{margin-left:0;width:100%;}
  }
  /* ===== Methodology footer ===== */
  .site-foot{background:#0B0B0C;color:#c7cbd1;margin-top:48px;}
  .foot-inner{max-width:1260px;margin:0 auto;padding:36px 24px 44px;display:grid;grid-template-columns:200px 1fr;gap:34px;}
  .foot-brand .mk-logo{font-family:var(--display);font-weight:800;font-size:22px;color:#fff;letter-spacing:-.02em;}
  .foot-brand .mk-dot{color:var(--accent);}
  .foot-tag{font-size:12.5px;color:#8a9097;margin-top:7px;}
  .foot-method h3{font-family:var(--display);font-size:15px;color:#fff;font-weight:700;margin-bottom:11px;}
  .foot-method p{font-size:13px;line-height:1.62;color:#b3b8bf;margin:0 0 11px;max-width:780px;}
  .foot-method .foot-fine{font-size:11.5px;color:#7e848b;}
  @media(max-width:680px){.foot-inner{grid-template-columns:1fr;gap:18px;}}
  @media print{
    body{background:#fff;} .tabs,.readme,.panel-actions,.brandbar .mk-title,.pillar-head .caret{display:none;}
    .panel{display:none!important;} .panel.active{display:block!important;}
    .btn,.stack-card{box-shadow:none;} .block,.pcard,.rank{break-inside:avoid;}
    .site-foot{background:#fff!important;color:var(--ink-soft)!important;border-top:1px solid var(--line);margin-top:24px;}
    .site-foot .mk-logo,.foot-method h3{color:var(--ink)!important;} .foot-method p{color:var(--ink-soft)!important;}
    .mk-logo-img{display:none!important;} .mk-print-word{display:inline!important;color:var(--ink)!important;}
  }
  /* ===== cloud / assessment bar ===== */
  .assess-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 24px;padding:11px 14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);}
  .assess-bar .ab-label{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--ink-soft);}
  .assess-bar select,.assess-bar .ab-input{border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-family:var(--body);font-size:13px;background:#fff;color:var(--ink);}
  .assess-bar .ab-input{min-width:170px;}
  .cloud-status{font-size:12px;color:var(--ink-soft);font-family:var(--mono);}
  .cloud-status.ok{color:var(--accent-deep);} .cloud-status.err{color:var(--gap);}

  /* ===== sub-nav / autosave / sync ===== */
  .subnav{max-width:1260px;margin:0 auto;padding:16px 24px 0;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
  .backlink{font-size:13px;font-weight:600;color:var(--accent);text-decoration:none;}
  .backlink:hover{text-decoration:underline;}
  .subnav .sn-title{font-family:var(--display);font-weight:700;font-size:15px;}
  .autosave{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--ink-soft);display:inline-flex;align-items:center;gap:7px;}
  .autosave .dot{width:8px;height:8px;border-radius:50%;background:var(--wont);transition:.2s;}
  .autosave.saving .dot{background:var(--should);} .autosave.saved .dot{background:var(--accent);} .autosave.err .dot{background:var(--gap);}
  .sync-banner{max-width:1260px;margin:14px auto 0;padding:11px 16px;background:var(--should-bg);border:1px solid #ECD9B0;border-radius:9px;color:#7A5A12;font-size:13px;display:none;align-items:center;gap:12px;}
  .sync-banner.show{display:flex;}
  /* ===== dashboard ===== */
  .dash-wrap{max-width:1100px;margin:0 auto;padding:30px 24px 80px;}
  .dash-msg{background:#EEF1FE;border:1px solid #D5DCFB;border-left:3px solid var(--accent);border-radius:9px;padding:13px 16px;color:#243072;font-size:13.5px;margin-bottom:22px;}
  .dash-msg.err{background:var(--gap-bg);border-color:#E2B6BC;border-left-color:var(--gap);color:#7d2630;}
  .dash-head{display:flex;align-items:center;gap:12px;margin:26px 0 22px;flex-wrap:wrap;}
  .dash-head h1{font-size:26px;font-family:var(--display);font-weight:700;letter-spacing:-.01em;}
  .dash-head .spacer{flex:1;}
  .assess-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px;}
  .assess-card{display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--shadow);transition:.12s;position:relative;}
  .assess-card:hover{border-color:var(--accent);transform:translateY(-1px);}
  .assess-card h3{font-family:var(--display);font-size:16px;font-weight:700;margin-bottom:3px;padding-right:22px;}
  .assess-card .ac-client{font-size:13px;color:var(--ink-soft);}
  .assess-card .ac-meta{font-family:var(--mono);font-size:11px;color:var(--ink-soft);margin-top:14px;}
  .assess-card .ac-del{position:absolute;top:10px;right:8px;border:none;background:none;color:var(--no);font-size:13px;cursor:pointer;border-radius:6px;padding:3px 7px;line-height:1;}
  .assess-card .ac-del:hover{color:var(--gap);background:var(--gap-bg);}
  .dash-empty{color:var(--ink-soft);font-size:14px;padding:34px 0;}

  /* ===== assessment results sub-headers ===== */
  .sec-h{font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:-.01em;margin:30px 0 14px;padding-bottom:9px;border-bottom:1px solid var(--line);}
  .results-actions{display:flex;justify-content:flex-end;margin:4px 0 4px;}

  /* ===== admin legend utilities ===== */
  .pencil{color:var(--leader);font-style:normal;font-weight:600;}
  .rat-dot{display:inline-block;width:9px;height:9px;border-radius:50%;vertical-align:middle;margin-right:2px;}
  .rat-dot.pro{background:var(--accent);} .rat-dot.con{background:var(--gap);} .rat-dot.note{background:var(--ink-soft);}

  /* ===== admin: tone-coloured rationale glyph (override .has gold) ===== */
  .noteglyph.tone-pro{color:var(--accent);} .noteglyph.tone-pro:hover{color:var(--accent-deep);}
  .noteglyph.tone-con{color:var(--gap);}
  .noteglyph.tone-note{color:var(--ink-soft);}

  /* ===== admin: collapsible, structured readme + spacing ===== */
  .readme.collapsible{padding:0;}
  .readme .rm-head{display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;padding:13px 16px;}
  .readme .rm-head .seccaret{margin-left:auto;}
  .readme.collapsible .sec-body{padding:0 16px 15px;}
  .readme.collapsible.collapsed .rm-head{padding-bottom:13px;}
  .readme .rm-list{margin:10px 0 0;padding-left:18px;}
  .readme .rm-list li{margin:5px 0;}
  .readme .rm-list em{font-style:normal;font-family:var(--mono);font-size:12px;color:var(--accent-deep);}
  .readme .pencil,.readme .drag-handle{margin:0 1px;}
  /* breathing room down the admin column */
  body[data-page="admin"] .wrap{padding-top:6px;}
  body[data-page="admin"] .readme{margin-bottom:20px;}
  body[data-page="admin"] .matrix-key{margin:2px 0 14px;padding-top:2px;}

  /* ===== admin: each pillar is its own card; vendor header pins on scroll ===== */
  .mtx-wrap{display:block;}
  .pillar-card{border:1px solid var(--line);border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow);margin-bottom:22px;overflow:visible;}
  .pillar-card:last-child{margin-bottom:0;}
  .pillar-card table.mtx{table-layout:fixed;width:100%;}
  .pillar-card table.mtx thead th{z-index:6;box-shadow:0 1px 0 var(--line);}

  /* ================================================================ */
  /* ===== USE CASES TAB ============================================= */
  /* ================================================================ */

  .uc-library-block, .uc-selected-block{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:16px 18px;margin-bottom:20px;}
  .uc-block-head{display:flex;align-items:baseline;gap:12px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--line-soft);}
  .uc-block-title{font-family:var(--display);font-weight:700;font-size:14px;letter-spacing:-.005em;}
  .uc-block-hint{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-left:auto;font-weight:600;}

  /* library chips (available templates) */
  .uc-library{display:flex;flex-wrap:wrap;gap:8px;}
  .uc-lib-chip{position:relative;border:1px solid var(--line);background:#fff;border-radius:20px;padding:7px 13px 7px 13px;font-size:12.5px;font-weight:500;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:.12s;font-family:var(--body);}
  .uc-lib-chip:hover{border-color:var(--accent);background:var(--yes-bg);color:var(--accent-deep);}
  .uc-lib-chip::before{content:"+";font-family:var(--mono);color:var(--accent);font-weight:700;font-size:14px;line-height:1;}
  .uc-lib-chip.used{opacity:.42;cursor:default;pointer-events:none;background:var(--line-soft);}
  .uc-lib-chip.used::before{content:"✓";color:var(--could);}
  .uc-custom-row{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line-soft);}

  /* selected use case cards */
  .uc-selected{display:flex;flex-direction:column;gap:12px;}
  .uc-empty{color:var(--ink-soft);font-size:13px;padding:18px 4px;font-style:italic;text-align:center;}
  .uc-card{border:1px solid var(--line);border-radius:9px;padding:14px 16px;background:#fff;position:relative;transition:border-color .12s;}
  .uc-card:hover{border-color:#CBD3E0;}
  .uc-card .uc-head{display:flex;align-items:flex-start;gap:10px;}
  .uc-card .uc-title{flex:1;font-family:var(--display);font-weight:700;font-size:14.5px;letter-spacing:-.005em;color:var(--ink);min-height:20px;line-height:1.35;}
  .uc-card .uc-title[contenteditable="true"]:empty::before{content:"Untitled use case";color:var(--ink-soft);font-style:italic;}
  .uc-card .uc-del{border:none;background:none;color:var(--no);font-size:15px;cursor:pointer;padding:2px 7px;line-height:1;border-radius:5px;flex:none;}
  .uc-card .uc-del:hover{color:var(--gap);background:var(--gap-bg);}
  .uc-card .uc-desc{margin-top:6px;color:var(--ink-soft);font-size:12.8px;line-height:1.5;min-height:18px;}
  .uc-card .uc-desc[contenteditable="true"]:empty::before{content:"Describe the client's specific situation — what outcome, what data, what audience…";color:#B7C0C2;font-style:italic;}
  [contenteditable="true"].uc-title:focus, [contenteditable="true"].uc-desc:focus{box-shadow:inset 0 0 0 2px var(--accent);background:#F7FBFB;}

  .uc-caps-wrap{margin-top:12px;padding-top:11px;border-top:1px solid var(--line-soft);}
  .uc-caps-label{font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:7px;display:flex;align-items:center;gap:8px;}
  .uc-caps-label .uc-caps-count{color:var(--accent-deep);}
  .uc-caps{display:flex;flex-wrap:wrap;gap:6px;align-items:center;}
  .uc-cap-chip{display:inline-flex;align-items:center;gap:6px;background:var(--yes-bg);color:var(--accent-deep);border:1px solid #D5DCFB;border-radius:14px;padding:3px 4px 3px 9px;font-size:11.5px;font-weight:500;line-height:1;}
  .uc-cap-chip .uc-cap-code{font-family:var(--mono);font-weight:600;font-size:10.5px;background:var(--accent-deep);color:#fff;padding:2px 5px;border-radius:3px;letter-spacing:.02em;}
  .uc-cap-chip .uc-cap-title{font-size:11.5px;padding-right:2px;}
  .uc-cap-chip .uc-cap-x{border:none;background:none;color:var(--accent-deep);font-size:13px;padding:2px 5px;border-radius:8px;cursor:pointer;line-height:1;}
  .uc-cap-chip .uc-cap-x:hover{background:#D5DCFB;color:var(--gap);}
  .uc-cap-none{color:var(--ink-soft);font-style:italic;font-size:12px;}

  /* + add capability picker */
  .uc-add-cap{position:relative;display:inline-block;}
  .uc-add-cap-btn{border:1px dashed var(--accent);background:#fff;color:var(--accent-deep);padding:4px 10px;font-size:11.5px;font-weight:600;border-radius:14px;cursor:pointer;display:inline-flex;align-items:center;gap:5px;font-family:var(--body);}
  .uc-add-cap-btn:hover{background:var(--yes-bg);}
  .uc-cap-pop{position:absolute;top:calc(100% + 6px);left:0;z-index:40;background:#fff;border:1px solid var(--line);border-radius:9px;box-shadow:0 10px 34px rgba(11,11,12,.18);padding:8px;min-width:340px;max-width:400px;max-height:360px;overflow-y:auto;display:none;}
  .uc-cap-pop.show{display:block;}
  .uc-cap-pop .ucp-pillar{margin-top:8px;}
  .uc-cap-pop .ucp-pillar:first-child{margin-top:0;}
  .uc-cap-pop .ucp-plname{font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;padding:3px 6px;background:var(--line-soft);border-radius:4px;margin-bottom:4px;}
  .uc-cap-pop .ucp-opt{display:flex;align-items:flex-start;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12.5px;line-height:1.35;}
  .uc-cap-pop .ucp-opt:hover{background:var(--yes-bg);}
  .uc-cap-pop .ucp-opt input{margin-top:2px;accent-color:var(--accent);flex:none;}
  .uc-cap-pop .ucp-opt .ucp-code{font-family:var(--mono);font-size:10.5px;color:var(--accent);font-weight:600;flex:none;padding-top:1px;}
  .uc-cap-pop .ucp-opt.checked{background:var(--yes-bg);}
  .uc-cap-pop .ucp-close{margin-top:8px;padding-top:8px;border-top:1px solid var(--line-soft);display:flex;justify-content:flex-end;}
  .uc-cap-pop .ucp-close button{border:none;background:none;color:var(--accent);font-size:11.5px;font-weight:600;cursor:pointer;padding:4px 8px;font-family:var(--mono);}

  /* ================================================================ */
  /* ===== USE-CASE FOOTNOTE UNDER EACH CAPABILITY ON PRIORITIZATION == */
  /* ================================================================ */
  .cap-usecases{margin-top:10px;padding:8px 10px;background:#F9FAFC;border:1px solid var(--line-soft);border-left:2px solid var(--accent);border-radius:6px;font-size:12px;color:var(--ink-soft);line-height:1.5;display:flex;align-items:flex-start;gap:8px;flex-wrap:wrap;}
  .cap-usecases .cu-label{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--accent-deep);flex:none;padding-top:2px;}
  .cap-usecases .cu-list{flex:1;min-width:200px;display:flex;flex-wrap:wrap;gap:5px 4px;}
  .cap-usecases .cu-uc{display:inline-flex;align-items:center;background:#fff;border:1px solid #D5DCFB;color:var(--accent-deep);padding:2px 8px;border-radius:11px;font-size:11.5px;font-weight:500;}
  .cap-nouse{margin-top:10px;padding:8px 10px;background:var(--wont-bg);border:1px solid #DDE0E4;border-left:2px solid var(--wont);border-radius:6px;font-size:12px;color:var(--ink-soft);line-height:1.5;display:flex;align-items:flex-start;gap:8px;}
  .cap-nouse .cu-label{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--wont);flex:none;padding-top:2px;}
  .cap-nouse .cu-hint{flex:1;font-style:italic;}
  .cap.oos-cap .cap-usecases, .cap.oos-cap .cap-nouse{display:none;}

  /* ================================================================ */
  /* ===== USE CASE LIBRARY ADMIN PAGE =============================== */
  /* ================================================================ */
  .lib-editor{gap:14px;}
  .lib-editor .uc-card{position:relative;}
  .lib-seed-tag{font-family:var(--mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--accent-deep);background:var(--yes-bg);border:1px solid #D5DCFB;padding:2px 7px;border-radius:4px;line-height:1;flex:none;align-self:center;}
  .uc-cap-chip.missing{background:var(--gap-bg);border-color:#E2B6BC;color:var(--gap);}
  .uc-cap-chip.missing .uc-cap-code{background:var(--gap);}
  .uc-cap-chip.missing .uc-cap-x{color:var(--gap);}
  body[data-page="usecases"] .panel-actions{margin-top:6px;}

  /* ================================================================ */
  /* ===== DASHBOARD — restructured (metrics + sections) ============= */
  /* ================================================================ */
  body[data-page="dashboard"] .dash-wrap{padding-top:26px;}

  /* Metrics row */
  .metrics-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:2px 0 32px;}
  .metric-tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px;box-shadow:var(--shadow);position:relative;}
  .metric-tile::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:3px;background:var(--accent);border-radius:0 2px 2px 0;}
  .metric-value{font-family:var(--display);font-size:32px;font-weight:700;line-height:1;letter-spacing:-.02em;color:var(--ink);margin-bottom:9px;font-variant-numeric:tabular-nums;}
  .metric-label{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;color:var(--ink-soft);}

  /* Section chrome */
  .dash-section{margin-top:34px;}
  .dash-sec-head{display:flex;align-items:baseline;gap:14px;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--line);flex-wrap:wrap;}
  .dash-sec-head .spacer{flex:1;}
  .dash-sec-title{font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:-.005em;color:var(--ink);margin:0;}
  .dash-sec-hint{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;color:var(--ink-soft);}

  /* Platform admin tiles */
  .admin-tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
  .admin-tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:22px 24px;box-shadow:var(--shadow);text-decoration:none;color:inherit;transition:.14s;display:flex;flex-direction:column;gap:8px;position:relative;overflow:hidden;}
  .admin-tile::after{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent-deep);opacity:0;transition:opacity .14s;}
  .admin-tile:hover{border-color:var(--accent);transform:translateY(-1px);}
  .admin-tile:hover::after{opacity:1;}
  .at-eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--accent-deep);}
  .at-title{font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin-top:1px;}
  .at-desc{font-size:13px;line-height:1.55;color:var(--ink-soft);flex:1;margin-top:2px;}
  .at-meta{font-family:var(--mono);font-size:11.5px;color:var(--ink-soft);padding:10px 0 0;border-top:1px solid var(--line-soft);margin-top:6px;line-height:1.6;}
  .at-meta span{color:var(--ink);font-weight:600;}
  .at-cta{font-size:13px;font-weight:600;color:var(--accent);margin-top:4px;font-family:var(--display);}

  @media(max-width:820px){
    .metrics-row{grid-template-columns:repeat(2,1fr);}
    .admin-tiles{grid-template-columns:1fr;}
  }
  @media(max-width:480px){
    .metric-value{font-size:26px;}
  }

  /* ================================================================ */
  /* ===== RESULTS TAB — Coverage by use case ======================= */
  /* ================================================================ */
  .uc-coverage-wrap{display:block;margin-bottom:6px;}
  .uc-coverage-wrap[hidden]{display:none;}
  .uc-verdict{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--r);padding:18px 22px;margin-bottom:18px;box-shadow:var(--shadow);}
  .uc-verdict .uv-eyebrow{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--accent-deep);margin-bottom:4px;}
  .uc-verdict .uv-title{font-family:var(--display);font-size:22px;font-weight:700;letter-spacing:-.01em;color:var(--ink);margin-bottom:8px;line-height:1.15;}
  .uc-verdict .uv-body{font-size:13.5px;line-height:1.55;color:var(--ink-soft);}
  .uc-verdict .uv-body b{color:var(--ink);font-weight:600;}
  .uc-verdict .uv-detail{font-size:12.8px;line-height:1.55;color:var(--ink-soft);margin-top:8px;}
  .uc-verdict .uv-detail b{color:var(--ink);font-weight:600;}
  .uc-verdict .uv-runner{margin-top:12px;padding-top:11px;border-top:1px solid var(--line-soft);font-size:12.5px;color:var(--ink-soft);line-height:1.5;}
  .uc-verdict .uv-runner b{color:var(--ink);font-weight:600;}

  /* Small pillar/cap breadcrumb under each use case row title */
  .uc-caps-sub{font-family:var(--mono);font-size:10px;letter-spacing:.03em;color:var(--ink-soft);margin-top:3px;text-transform:none;font-weight:500;}
  /* ===== Retire / unretire (pillars, capabilities, sub-capabilities) =====
     Retired items are preserved in place but greyed and excluded from scoring.
     Same button toggles state; label switches between "Retire" and "Unretire". */
  .retired-tag{display:inline-block;font-family:var(--mono);font-size:9px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;color:var(--wont);background:var(--wont-bg);padding:1px 6px;border-radius:4px;margin-left:8px;vertical-align:middle;}
  .retired-tag.on-dark{background:#2a3744;color:#c2cdd1;}

  /* Admin matrix — dim retired rows/sections (single opacity layer per element; a sub row inside
     a retired pillar or capability is already covered by the ancestor rule, so it isn't re-dimmed). */
  tr.pillar-band.retired td{opacity:.6;}
  tr.cap-band.retired td{opacity:.6;}
  .pillar-card.pillar-retired tr.cap-band td,
  .pillar-card.pillar-retired td.sub-lbl,
  .pillar-card.pillar-retired td.mk,
  .pillar-card.pillar-retired td.act{opacity:.55;}
  tr.sub-retired td.sub-lbl,
  tr.sub-retired td.mk,
  tr.sub-retired td.act{opacity:.55;}
  tr.sub-retired td.sub-lbl .qtext{font-style:italic;}

  /* Row-level retire / unretire button (wider than the old × delete button to fit the label) */
  table.mtx thead th.actcol,table.mtx td.act{width:98px;}
  .row-retire{border:1px solid var(--line);background:#fff;color:var(--ink-soft);font-family:var(--mono);font-size:9.5px;letter-spacing:.04em;text-transform:uppercase;font-weight:600;padding:3px 9px;border-radius:5px;cursor:pointer;line-height:1.4;}
  .row-retire:hover{border-color:var(--accent);color:var(--accent-deep);background:var(--yes-bg);}

  /* Workshop (framework / prioritization) view — grey retired items so consultants see they're out of scope */
  .pillar.pillar-retired > .pillar-head{opacity:.7;}
  .pillar.pillar-retired > .pillar-body{opacity:.55;}
  .cap.cap-retired{opacity:.55;}
  .sub-row.sub-retired .sub-q{font-style:italic;color:var(--ink-soft);}

  /* Pillar coverage table (results tab) — retired pillar rows are dimmed */
  table.agg tr.row-retired td{opacity:.55;}
