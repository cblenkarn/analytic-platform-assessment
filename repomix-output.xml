  .pc-label.pro{color:var(--accent-deep);} .pc-label.con{color:var(--must);}
  .pc-text{font-size:12.5px;color:var(--ink-soft);line-height:1.5;margin-bottom:4px;display:flex;gap:7px;}
  .pc-text .b{color:var(--line);flex:none;} .pc-text.con .b{color:#d9b3b8;}
