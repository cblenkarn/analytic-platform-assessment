  .cap-title-wrap{flex:1;min-width:240px;}
  .cap-title{font-weight:600;font-size:14.5px;display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
  .cap-title .selcount{font-family:var(--mono);font-size:10.5px;font-weight:500;color:var(--ink-soft);background:var(--line-soft);padding:1px 7px;border-radius:20px;}
